# Place this at the ROOT of the repo (above all your Unity project folders).
# No leading slashes on folder rules, so they match at ANY depth
# (e.g. Project1/Library/, Week3/Game/Library/, etc.)

# --- Unity generated folders ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
*.log

# --- Visual Studio / Rider / VS Code ---
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
**/Assets/Plugins/Editor/JetBrains*

# --- Unity generated meta files ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Crash / debug ---
sysinfo.txt
mono_crash.*

# --- Blender backups ---
*.blend1
*.blend1.meta

# --- Builds ---
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# --- Crashlytics ---
crashlytics-build.properties

# --- Test runner ---
InitTestScene*.unity*
**/Assets/[Ii]nit[Tt]est[Ss]cene*.unity*

# --- Addressables ---
ServerData/
**/Assets/StreamingAssets/aa*
**/Assets/AddressableAssetsData/link.xml*
**/Assets/Addressables_Temp*
**/Assets/AddressableAssetsData/*/*.bin*

# --- Visual Scripting generated ---
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# --- UI Toolkit ---
UIElementsSchema/

# --- Scene dependency cache ---
**/Assets/[Ss]ceneDependencyCache*

# --- OS junk ---
.DS_Store
Thumbs.db
